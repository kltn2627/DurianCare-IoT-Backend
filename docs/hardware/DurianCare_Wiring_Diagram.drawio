rap;html=1;fillColor=none;strokeColor=#E65100;opacity=100;" vertex="1" parent="1"><mxGeometry x="771.2" y="506.3" width="25.6" height="25.6" as="geometry"/></mxCell><mxCell id="p1-192" value="J1 · điểm chia 3V3 cho S1 và S2 (breadboard / dây chữ Y / mối hàn?)" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;fontSize=9.3;fontColor=#E65100;fontStyle=1;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="377.4" y="642.0" width="394.6" height="16.1" as="geometry"/></mxCell><mxCell id="p1-193" value="⚠ Cảm biến đất phải cấp 3V3, KHÔNG cấp 5V:&lt;br&gt;   AO có thể vượt 3,3 V và làm hỏng GPIO34." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.6;fontColor=#E65100;fontStyle=1;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="40.0" y="120.0" width="289.9" height="31.5" as="geometry"/></mxCell><mxCell id="p1-194" value="GPIO34 chỉ là ngõ vào analog (ADC1_CH6),&lt;br&gt;dùng được khi Wi-Fi đang bật." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.6;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="40.0" y="164.0" width="270.3" height="31.5" as="geometry"/></mxCell><mxCell id="p1-195" value="Giá trị đọc hiện ≈ 0 gần như mọi lần → đo AO&lt;br&gt;bằng đồng hồ trước khi tin số liệu (mục 5 hướng dẫn)." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.9;fontColor=#E65100;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="40.0" y="640.0" width="332.3" height="29.7" as="geometry"/></mxCell><mxCell id="p1-196" value="R1 10 kΩ (DATA → VCC): chỉ cần khi&lt;br&gt;dùng cảm biến 4 chân trần. Module&lt;br&gt;3 chân thường đã có sẵn." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.2;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="952.0" y="120.0" width="222.0" height="43.6" as="geometry"/></mxCell><mxCell id="p1-197" value="⚠ Module 3 chân hay 4 chân?" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.6;fontColor=white;fontStyle=1;fillColor=#E65100;strokeColor=#E65100;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="952.0" y="179.1" width="185.0" height="17.7" as="geometry"/></mxCell><mxCell id="p1-198" value="" style="rounded=1;arcSize=15;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1.3;dashed=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="904.0" y="212.0" width="256.0" height="104.0" as="geometry"/></mxCell><mxCell id="p1-199" value="Mạng (không phải dây điện)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.0;fontColor=#00695C;fontStyle=1;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="916.0" y="220.2" width="201.2" height="19.6" as="geometry"/></mxCell><mxCell id="p1-200" value="Wi-Fi 2,4 GHz → router →&lt;br&gt;Backend DurianCare: HTTP POST&lt;br&gt;/api/v1/sensors/data, UDP 4210" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.6;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="916.0" y="248.0" width="204.7" height="45.2" as="geometry"/></mxCell><mxCell id="p1-201" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#00897B;strokeWidth=1.5;dashed=0;opacity=100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="794.0" y="195.6" as="sourcePoint"/><mxPoint x="806.0" y="195.6" as="targetPoint"/><Array as="points"><mxPoint x="800.0" y="192.0"/></Array></mxGeometry></mxCell><mxCell id="p1-202" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#00897B;strokeWidth=1.5;dashed=0;opacity=100;" edge="1" paren
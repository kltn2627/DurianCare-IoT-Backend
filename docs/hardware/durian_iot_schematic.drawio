        <mxCell id="c70" value="" style="endArrow=none;html=1;strokeColor=#1E7B34;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="546" y="280" as="sourcePoint" />
            <mxPoint x="506" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c71" value="3V3" style="text;html=1;align=center;fontStyle=1;fontColor=#8B1A1A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="486" y="254" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c72" value="" style="endArrow=none;html=1;strokeColor=#1E7B34;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="546" y="340" as="sourcePoint" />
            <mxPoint x="506" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c73" value="GND" style="text;html=1;align=center;fontStyle=1;fontColor=#8B1A1A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="486" y="344" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c74" value="" style="endArrow=none;html=1;strokeColor=#1E7B34;strokeWidth=2;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1306" y="330" as="sourcePoint" />
            <mxPoint x="1266" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c75" value="GND" style="text;html=1;align=center;fontStyle=1;fontColor=#8B1A1A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1246" y="334" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c76" value="3V3" style="text;html=1;align=center;fontStyle=1;fontColor=#8B1A1A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="398" y="146" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c77" value="IO0 nối GND khi nạp, để hở khi chạy" style="text;html=1;align=left;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1070" y="580" width="360" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c78" value="1. Nét liền: chân đã khai báo trong firmware. DHT22→GPIO18 đã có dữ liệu thật (33 °C / 81 %, 22/10/2026)." style="text;html=1;align=left;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="755" width="1120" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c79" value="2. Nét đứt / dấu (?): nguồn cấp, điện trở kéo lên, bộ nạp — chưa có bằng chứng, cần xác nhận trên mạch thật." style="text;html=1;align=left;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="779" width="1120" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c80" value="3. S2 phải cấp 3,3 V: nếu cấp 5 V, AO có thể vượt 3,3 V của ADC ESP32. Log ghi raw = 0 gần như mọi lần đọc → kiểm tra dây AO/VCC." style="text;html=1;align=left;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="803" width="1120" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c81" value="4. GPIO34 thuộc ADC1, chỉ nhập, không phải chân strapping; dùng được khi Wi-Fi bật (ADC2 thì không)." style="text;html=1;align=left;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="827" width="1120" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c82" value="5. U2 không nối cảm biến ngoài. Các chân camera OV2640 (DVP) là cố định trên board AI-Thinker, xem bảng pin trong HARDWARE.md." style="text;html=1;align=left;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="851" width="1120" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c83" value="6. Báo cáo B ghi DHT22 ở GPIO23 và cảm biến mưa ở GPIO35: firmware hiện tại không dùng hai chân này." style="text;html=1;align=left;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="875" width="1120" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c84" value="&lt;b&gt;TITLE: DurianCare IoT — Sơ đồ nguyên lý&lt;/b&gt;&lt;br&gt;REV 1.0 · 28/10/2026 · Sheet 1/1&lt;br&gt;Liền = theo firmware · Đứt = chưa xác minh" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#8B1A1A;fillColor=none;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="920" width="490" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="524.4" width="356.8" height="16.8" as="geometry"/></mxCell><mxCell id="p1-119" value="2. GPIO34: ngõ vào, không có điện trở kéo nội; ADC1 dùng được khi Wi-Fi bật." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.9;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="545.2" width="473.1" height="16.8" as="geometry"/></mxCell><mxCell id="p1-120" value="   Arduino-ESP32 mặc định suy hao 11 dB: đọc tới ~3,1 V; tuyến tính tốt ~0,15–2,45 V." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.9;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="566.0" width="528.1" height="16.8" as="geometry"/></mxCell><mxCell id="p1-121" value="3. AO tỉ lệ với VCC của S2 → S2 phải cấp 3V3 để AO ≤ 3,3 V." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.9;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="586.8" width="369.0" height="16.8" as="geometry"/></mxCell><mxCell id="p1-122" value="4. Firmware: map(raw, 3200 → 0 %, 1200 → 100 %), hiệu chuẩn thực nghiệm." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.9;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="607.6" width="448.6" height="16.8" as="geometry"/></mxCell><mxCell id="p1-123" value="5. DHT22: 3,3–5,5 V, chu kỳ đọc ≥ 2 s; datasheet khuyên kéo lên 5,1 kΩ (thường dùng 10 kΩ)." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.9;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="628.4" width="564.9" height="16.8" as="geometry"/></mxCell><mxCell id="p1-124" value="6. Chưa xác minh: loại DevKit, cách chia 3V3 (J1 trên wiring), S1 3 hay 4 chân, nguồn S1/S2, loại P1." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.9;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="649.2" width="626.1" height="16.8" as="geometry"/></mxCell><mxCell id="p1-125" value="" style="rounded=0;arcSize=0;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#1A1A1A;strokeWidth=1.1;dashed=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="768.0" y="732.0" width="400.0" height="88.0" as="geometry"/></mxCell><mxCell id="p1-126" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1A1A1A;strokeWidth=0.7;dashed=0;opacity=100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="768.0" y="764.0" as="sourcePoint"/><mxPoint x="1168.0" y="764.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-127" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1A1A1A;strokeWidth=0.7;dashed=0;opacity=100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="768.0" y="792.0" as="sourcePoint"/><mxPoint x="1168.0" y="792.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-128" value="DurianCare IoT — Trạm cảm biến" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.6;fontColor=#1A1A1A;fontStyle=1;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="776.0" y="739.1" width="204.7" height="17.7" as="geometry"/></mxCell><mxCell id="p1-129" value="Tờ 1/2  ·  Rev B · 29/10/2026  ·  nguồn: generate_hardware_docs.py" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.2;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="7
tPoint"/></mxGeometry></mxCell><mxCell id="p2-92" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1A1A1A;strokeWidth=1.3;dashed=0;opacity=100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="851.2" y="352.0" as="sourcePoint"/><mxPoint x="876.8" y="352.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-93" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1A1A1A;strokeWidth=1.3;dashed=0;opacity=100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="856.0" y="356.8" as="sourcePoint"/><mxPoint x="872.0" y="356.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-94" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1A1A1A;strokeWidth=1.3;dashed=0;opacity=100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860.8" y="361.6" as="sourcePoint"/><mxPoint x="867.2" y="361.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-95" value="JP1 · IO0–GND" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=9.9;fontColor=#1A1A1A;fontStyle=1;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="772.2" y="335.6" width="87.6" height="16.8" as="geometry"/></mxCell><mxCell id="p2-96" value="đóng: nạp · mở: chạy" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=8.7;fontColor=#FB8C00;fontStyle=1;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="757.8" y="352.3" width="116.4" height="15.4" as="geometry"/></mxCell><mxCell id="p2-97" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1A1A1A;strokeWidth=1.3;dashed=0;opacity=100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="744.0" y="372.0" as="sourcePoint"/><mxPoint x="776.0" y="372.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-98" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1A1A1A;strokeWidth=1.3;dashed=0;opacity=100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="776.0" y="372.0" as="sourcePoint"/><mxPoint x="776.0" y="384.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-99" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1A1A1A;strokeWidth=1.3;dashed=0;opacity=100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="763.2" y="384.0" as="sourcePoint"/><mxPoint x="788.8" y="384.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-100" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1A1A1A;strokeWidth=1.3;dashed=0;opacity=100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="768.0" y="388.8" as="sourcePoint"/><mxPoint x="784.0" y="388.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-101" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1A1A1A;strokeWidth=1.3;dashed=0;opacity=100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="772.8" y="393.6" as="sourcePoint"/><mxPoint x="779.2" y="393.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-102" value="Ghi chú kỹ thuật" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.3;fontColor=#1A1A1A;fontStyle=1;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="550.7" width="119.9" height="18.7" as="geometry"/></mxCell><mxCell id="p2-103" value="1. Nguồn vào chân 5V qua LDO trên board; Wi-Fi + camera có đỉnh dòng vài trăm mA," style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.9;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="571.6" width="503.7" height="16.8" as="geometry"/></mxCell><mxCell id="p2-104" value="   LED flash GPIO4 tăng thêm → nguồn yếu gây brownout / reset liên tục." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.9;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="591.6" width="442.5" height="16.8" as="geometry"/></mxCell><mxCell id="p2-105" value="2. UART0 dùng để nạp (115200 baud log). TX/RX nối chéo, mức 3,3 V." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.9;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="611.6" width="411.9" height="16.8" as="geometry"/></mxCell><mxCell id="p2-106" value="3. GPIO0 vừa là chân chọn chế độ khởi động vừa là XCLK camera → JP1 phải mở khi chạy." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.9;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="631.6" width="528.1" height="16.8" as="geometry"/></mxCell><mxCell id="p2-107" value="4. GPIO12 (MTDI) là chân strapping điện áp flash — không kéo lên khi khởi động." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.9;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="651.6" width="491.4" height="16.8" as="geometry"/></mxCell><mxCell id="p2-108" value="5. Firmware CameraWebServer: CAMERA_MODEL_AI_THINKER, PSRAM, không dùng thẻ SD." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.9;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="671.6" width="491.4" height="16.8" as="geometry"/></mxCell><mxCell id="p2-109" value="6. Chưa xác minh: loại adapter/đế nạp, nguồn PS2, cảm biến OV2640 (chưa đọc PID)." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.9;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="48.0" y="691.6" width="503.7" height="16.8" as="geometry"/></mxCell><mxCell id="p2-110" value="" style="rounded=0;arcSize=0;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#1A1A1A;strokeWidth=1.1;dashed=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="768.0" y="732.0" width="400.0" height="88.0" as="geometry"/></mxCell><mxCell id="p2-111" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1A1A1A;strokeWidth=0.7;dashed=0;opacity=100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="768.0" y="764.0" as="sourcePoint"/><mxPoint x="1168.0" y="764.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-112" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1A1A1A;strokeWidth=0.7;dashed=0;opacity=100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="768.0" y="792.0" as="sourcePoint"/><mxPoint x="1168.0" y="792.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-113" value="DurianCare IoT — Camera" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.6;fontColor=#1A1A1A;fontStyle=1;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="776.0" y="739.1" width="158.8" height="17.7" as="geometry"/></mxCell><mxCell id="p2-114" value="Tờ 2/2  ·  Rev B · 29/10/2026  ·  nguồn: generate_hardware_docs.py" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.2;fontColor=#1A1A1A;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="776.0" y="770.0" width="383.0" height="15.9" as="geometry"/></mxCell><mxCell id="p2-115" value="Bản vẽ tài liệu, không phải bản vẽ sản xuất PCB" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.2;fontColor=#555555;fontStyle=0;fillColor=none;strokeColor=none;rotation=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="776.0" y="798.0" width="275.1" height="15.9" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
# Non-secret template only. Service/database credentials are supplied separately.
# Registry mode requires no static camera IP.
CAMERA_OFFLINE_TIMEOUT_MIN=5
ESP32_CAPTURE_PATH=/capture
CAMERA_LEGACY_ENABLED=false
ESP32_CAMERA_URL=
# Set securely in the deployment environment: JSON keyed by stable camera ID.
# Each binding has key (at least 32 characters), farmId and optional zoneId.
# Do not commit populated device bindings or actual .env files.
CAMERA_DEVICE_BINDINGS=
# Broker address returned to devices by GET /api/v1/public/devices/mqtt-config (LAN IP, not "emqx").
MQTT_PUBLIC_HOST=
MQTT_PUBLIC_PORT=1883
MQTT_REGISTER_TOPIC=esp32/camera/register

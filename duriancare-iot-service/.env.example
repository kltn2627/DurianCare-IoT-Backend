# Non-secret template only. Service/database credentials are supplied separately.
# Registry mode requires no static camera IP.
CAMERA_OFFLINE_TIMEOUT_MIN=5
ESP32_CAPTURE_PATH=/capture
CAMERA_LEGACY_ENABLED=false
ESP32_CAMERA_URL=
# Set securely in the deployment environment: JSON keyed by stable camera ID.
# Each binding has key (at least 32 characters), farmId and optional zoneId.
# Do not commit populated device bindings or actual .env files.
CAMERA_DEVICE_BINDINGS=
# Broker address returned to devices by GET /api/v1/public/devices/mqtt-config (LAN IP, not "emqx").
MQTT_PUBLIC_HOST=
MQTT_PUBLIC_PORT=1883
MQTT_REGISTER_TOPIC=esp32/camera/register

# ── Cloud-ready (docs/IOT_CLOUD_READY.md) ──
# LOCAL: backend on the farm LAN (UDP beacon). CLOUD: backend on the internet behind HTTPS.
IOT_DEPLOYMENT_MODE=LOCAL
# Sensor X-Device-Token: OPTIONAL accepts legacy token-less firmware, REQUIRED rejects it.
# Empty = OPTIONAL in LOCAL, REQUIRED in CLOUD.
IOT_DEVICE_AUTH_MODE=
# PUSH: camera uploads frames and polls commands. PULL: legacy backend GET <camera>/capture (LOCAL only).
CAMERA_DELIVERY_MODE=PUSH
# LOCAL only: use the legacy pull path for cameras whose firmware does not report the "push" capability.
CAMERA_PULL_FALLBACK=false
CAMERA_FRAME_MAX_BYTES=2097152
CAMERA_COMMAND_TTL_SECONDS=120
CAMERA_SCHEDULED_COMMAND_TTL_SECONDS=600
CAMERA_COMMAND_POLL_MS=5000
# Public base URL that devices use (shown on the setup screen), e.g. https://api.duriancare.io.vn/iot
IOT_PUBLIC_BASE_URL=
